{
  "name": "circe-graph",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "seed": "node seed.ts",
    "demo": "node demos/01-graph-grounding.ts",
    "demo:memory": "node demos/02-memory-across-sessions.ts",
    "demo:ask": "node demos/03-ask-the-graph.ts",
    "mcp": "node mcp/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:mcp": "node demos/04-mcp-conversation.ts",
    "chat": "node mcp/chat.ts",
    "test:shuffle": "vitest run --sequence.shuffle --sequence.seed=3",
    "check": "pnpm typecheck && pnpm test && pnpm test:shuffle && pnpm demo:mcp",
    "demo:agent": "node demos/05-codex-agent.ts",
    "demo:record": "node demos/record-agent-demo.ts"
  },
  "dependencies": {
    "falkordb": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
