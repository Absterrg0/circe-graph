# circe-graph environment (all optional; defaults shown).
# Copy to .env and adjust — the scripts read these from the process env.

# Explicit graph name. Takes precedence over CIRCE_TENANT.
# CIRCE_GRAPH=circe

# Tenant isolation: selects the graph "circe:<tenant>".
# One tenant per graph in a single FalkorDB instance.
# CIRCE_TENANT=alice

# FalkorDB connection (defaults: localhost:6379).
# FALKOR_HOST=localhost
# FALKOR_PORT=6379

# FalkorDB Cloud / TLS: a full connection URL takes precedence over host/port.
# FALKOR_URL=rediss://user:password@host:port
# ...or keep host/port and turn on TLS explicitly:
# FALKOR_TLS=1
